rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Per-user object paths: users may only read/write their own files.
    // App currently uploads nothing to Firebase Storage; this keeps the
    // surface locked down by default and scoped per-user for future use.
    match /{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

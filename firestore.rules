rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // teams/{teamId} — members array contains uid, ownerId names the owner.
    match /teams/{teamId} {
      // Team query is `members array-contains uid`, so any signed-in user
      // must be able to read team docs to see their own teams.
      allow read: if request.auth != null;
      // Only the owner may create/update/delete a team document.
      allow create, update: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // users/{uid} — self-only writes.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny — no catch-all allow.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

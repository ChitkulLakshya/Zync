# =============================================================================
# Zync — Frontend environment variables
# Copy to `.env` and fill in values. None are secrets in the npm-publish sense,
# but treat Firebase/GitHub app credentials as private config.
#
# All VITE_* vars are inlined at build time by Vite. Changing them requires a
# rebuild. See https://vite.dev/guide/env-and-mode.
# =============================================================================

# --- Firebase web app config (from Firebase console → Project settings) ---
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
VITE_FIREBASE_VAPID_KEY=your-vapid-key

# --- reCAPTCHA Enterprise site key (used for auth flows) ---
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# --- Backend / sockets ---
# Leave empty in dev to use the Vite proxy (vite.config.ts proxies /api → 5000).
# Set to your deployed API origin for a real backend.
VITE_API_URL=
# Socket.io server origin. Empty in dev (proxied). Set for production.
VITE_SOCKET_URL=
# Kilo Code Gateway origin (architecture-agent endpoints).
# Leave empty to fall back to VITE_API_URL. Set this when deploying the
# architecture/AI services on a separate Render account.
VITE_KILO_API_URL=

# --- GitHub App name shown in the UI ---
VITE_GITHUB_APP_NAME=your-github-app-name

# --- Feature toggles ---
# Sync dev users / tasks through Firestore instead of the API. Keep false in prod.
VITE_ENABLE_DEV_USER_SYNC=false
VITE_ENABLE_TASK_FIRESTORE_SYNC=false

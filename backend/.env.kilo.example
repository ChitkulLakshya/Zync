# =============================================================================
# Zync Kilo Code Gateway — environment variables
# This is the standalone AI micro-service (kilo-gateway-server.js).
# Copy to backend/.env.kilo and fill in values, OR set directly in the
# Render dashboard for the zync-kilo-gw service.
# =============================================================================

# --- Server ---
NODE_ENV=production
PORT=5001                           # Render sets this automatically
FRONTEND_URL=https://your-app.vercel.app   # Required for CORS
ALLOWED_ORIGINS=                    # comma-separated extra origins if any

# --- MongoDB (same cluster as main backend) ---
# The gateway reads project docs for context in the architecture-agent chat.
MONGO_URI=mongodb+srv://...

# --- Redis (same instance as main backend) ---
# Quota counters (weekly gen limit per user) live here.
REDIS_URL=redis://...
REDIS_TLS=false                     # true if using rediss://
REDIS_TLS_REJECT_UNAUTHORIZED=true

# --- Firebase Admin ---
# Used to verify Firebase ID tokens on every auth-gated request.
# Provide either the raw JSON string or a path to the service account file.
FIREBASE_SERVICE_ACCOUNT=
GCP_SERVICE_ACCOUNT_KEY=

# --- Kilo Code Gateway (REQUIRED) ---
# Without these the service starts but returns 503 on all AI endpoints.
KILO_CODE_GATEWAY_URL=https://api.kilo.dev
KILO_CODE_GATEWAY_API_KEY=
KILO_CODE_GATEWAY_MODEL=kilo-auto/free

# =============================================================================
# Zync — Backend environment variables
# Copy to `backend/.env`. Treat every value as a secret — never commit this file.
# =============================================================================

# --- Server ---
NODE_ENV=development            # development | production | test
PORT=5000                       # HTTP port (Render/vercel use their own)
FRONTEND_URL=http://localhost:8081   # CORS origin for the web app
ALLOWED_ORIGINS=                # comma-separated extra origins, if any
LOG_LEVEL=info                  # debug | info | warn | error

# --- Database (MongoDB / Prisma) ---
# Primary app DB. Get a free Atlas cluster or self-host Mongo.
MONGO_URI=mongodb://localhost:27017/zync
# Migration scripts only — SOURCE_URI/TARGET_URI replace hardcoded connection strings.
SOURCE_URI=
SOURCE_DB=
TARGET_URI=
TARGET_DB=

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_TLS=false                 # true if REDIS_URL is rediss://
REDIS_TLS_REJECT_UNAUTHORIZED=true

# --- Firebase Admin (server-side) ---
# Path to a service-account JSON, OR the raw JSON string.
GCP_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT=

# --- Encryption keys (REQUIRED in production — app throws if missing) ---
# Master key for GitHub App private key + OAuth token encryption.
MASTER_ENCRYPTION_KEY=
# Legacy key used to decrypt stored GitHub access tokens.
ENCRYPTION_KEY=

# --- GitHub App / OAuth ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=         # the PEM contents (or GITHUB_PRIVATE_KEY)
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_TOKEN=             # optional, for admin operations
GITHUB_REPO_NAME=
GITHUB_REPO_OWNER=

# --- Google (OAuth, Sheets, calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# --- AI providers ---
GROQ_API_KEY=
GEMINI_API_KEY_SECONDARY=
# Kilo Code Gateway (architecture analysis + agent chat). URL + key required
# for architecture features to work.
KILO_CODE_GATEWAY_URL=
KILO_CODE_GATEWAY_API_KEY=
KILO_CODE_GATEWAY_MODEL=kilo-auto/free

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_HOST=                     # alias used by weekly-test reporting
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
SUPPORT_RECIPIENTS=
NEW_USER_ALERT_RECIPIENTS=
ADMIN_EMAIL=

# --- LinkedIn OAuth ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Cloudinary (profile photo + image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Load shedding (free-tier protection) ---
LOAD_SHED_HEAP_LIMIT_MB=256
LOAD_SHED_RETRY_AFTER_SECONDS=30
LOAD_SHED_HEAVY_PATHS=/api/projects/generate-project

# --- Architecture analysis cache ---
ARCHITECTURE_CACHE_MAX_ENTRIES=100
ARCHITECTURE_CACHE_TTL_MS=21600000

# --- Socket delivery catch-up ---
DELIVERY_CATCHUP_BATCH_SIZE=100
DELIVERY_CATCHUP_MAX_BATCHES=10

# --- Internal API (metrics + diagnostics). NOT exposed publicly. ---
# Guards /internal/* with an x-internal-secret header.
INTERNAL_API_SECRET=

# --- Misc / debug ---
DEBUG=false
DEBUG_WEBHOOKS=false
PUPPETEER_NO_SANDBOX=true
SHARED_BROWSER_IDLE_MS=120000
